# Chave da API do Google Gemini (obtenha gratuitamente em https://aistudio.google.com/apikey)
# Na Vercel, defina esta variável em Settings > Environment Variables
GEMINI_API_KEY=

# Senha pessoal para proteger o painel na internet (OBRIGATÓRIA na Vercel)
# Localmente pode ficar vazia se você não quiser tela de login no seu PC
APP_PASSWORD=

# Opcional: segredo aleatório para assinar o cookie de sessão (se vazio, deriva de APP_PASSWORD)
# SESSION_SECRET=

# Supabase (obrigatório na Vercel para persistir seus estudos na nuvem)
# Encontre em Supabase > Project Settings > API / Data API
SUPABASE_URL=
# Use a chave Secret (sb_secret_...) ou a legada service_role (NUNCA a chave anon/publishable)
SUPABASE_SECRET_KEY=

# Porta do servidor local (ignorada na Vercel)
PORT=3000

# Opcional (recomendado em VPS com Tailscale/Caddy na mesma máquina): restrinja o bind para 127.0.0.1
# HOST=127.0.0.1
